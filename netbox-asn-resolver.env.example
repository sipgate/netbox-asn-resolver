# Copy to /etc/default/netbox-dns-resolver
# --- Netbox (required) ---
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=changeme

# --- Sync ---
SYNC_INTERVAL=10m

# --- DNS server ---
DNS_LISTEN_ADDR=:53
DNS_ZONE=asn.cymru.com.
UPSTREAM_DNS=8.8.8.8:53
UPSTREAM_ZONE=asn.cymru.com.

# --- Metrics ---
METRICS_LISTEN_ADDR=:2112

# --- Response formatting ---
# Placeholders match native Netbox ASN object fields.
NETBOX_TXT_FORMAT=%{asn} | %{rir.name} | netbox | %{created} | %{description}
